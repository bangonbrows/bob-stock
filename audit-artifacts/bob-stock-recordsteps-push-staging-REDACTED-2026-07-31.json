{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "actions": {
    "Authorized": {
      "actions": {
        "Call_money": {
          "inputs": {
            "body": {
              "steps": "@coalesce(triggerBody()?['data']?['steps'],json('[]'))"
            },
            "headers": {
              "Content-Type": "application/json"
            },
            "method": "POST",
            "uri": "https://bob-stock-money-fn.azurewebsites.net/api/validateMoney?code=REDACTED"
          },
          "runAfter": {},
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          },
          "type": "Http"
        },
        "Context_loop": {
          "actions": {
            "Batch_genesis": {
              "inputs": {
                "from": "@body('ToInsert')",
                "where": "@and(equals(item()?['row']?['RecordId'],items('Context_loop')?['row']?['RecordId']),equals(item()?['row']?['StepType'],'submit'),equals(item()?['row']?['RecordType'],'transfer'))"
              },
              "runAfter": {},
              "type": "Query"
            },
            "Ctx_has_genesis": {
              "actions": {
                "Ctx_match": {
                  "actions": {},
                  "else": {
                    "actions": {
                      "Append_ctx_reject": {
                        "inputs": {
                          "name": "ctx",
                          "value": {
                            "StepId": "@items('Context_loop')?['row']?['StepId']",
                            "kind": "reject",
                            "row": "@items('Context_loop')?['row']"
                          }
                        },
                        "runAfter": {},
                        "type": "AppendToArrayVariable"
                      }
                    }
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@coalesce(items('Context_loop')?['row']?['FromStoreId'],'')",
                          "@if(greater(length(body('Batch_genesis')),0),coalesce(first(body('Batch_genesis'))?['row']?['FromStoreId'],''),coalesce(first(coalesce(body('Get_genesis')?['spBody'],body('Get_genesis'))?['value'])?['FromStoreId'],''))"
                        ]
                      },
                      {
                        "equals": [
                          "@coalesce(items('Context_loop')?['row']?['ToStoreId'],'')",
                          "@if(greater(length(body('Batch_genesis')),0),coalesce(first(body('Batch_genesis'))?['row']?['ToStoreId'],''),coalesce(first(coalesce(body('Get_genesis')?['spBody'],body('Get_genesis'))?['value'])?['ToStoreId'],''))"
                        ]
                      }
                    ]
                  },
                  "runAfter": {},
                  "type": "If"
                }
              },
              "else": {
                "actions": {
                  "Append_ctx_pending": {
                    "inputs": {
                      "name": "ctx",
                      "value": {
                        "StepId": "@items('Context_loop')?['row']?['StepId']",
                        "kind": "pending",
                        "row": "@items('Context_loop')?['row']"
                      }
                    },
                    "runAfter": {},
                    "type": "AppendToArrayVariable"
                  }
                }
              },
              "expression": {
                "or": [
                  {
                    "greater": [
                      "@length(body('Batch_genesis'))",
                      0
                    ]
                  },
                  {
                    "greater": [
                      "@length(coalesce(body('Get_genesis')?['value'],json('[]')))",
                      0
                    ]
                  }
                ]
              },
              "runAfter": {
                "Get_genesis": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "If"
            },
            "Get_genesis": {
              "inputs": {
                "body": {
                  "headers": {
                    "Accept": "application/json;odata=nometadata"
                  },
                  "method": "GET",
                  "uri": "@{concat('_api/web/lists/getbytitle(''RecordSteps_Staging'')/items?$select=FromStoreId,ToStoreId&$top=1&$filter=RecordId eq ''',replace(items('Context_loop')?['row']?['RecordId'],'''',''),''' and StepType eq ''submit'' and RecordType eq ''transfer''')}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://bangonbrows.sharepoint.com'))}/httpRequest"
              },
              "runAfter": {
                "Batch_genesis": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection"
            }
          },
          "foreach": "@body('Context_steps')",
          "runAfter": {
            "Context_steps": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "type": "Foreach"
        },
        "Context_steps": {
          "inputs": {
            "from": "@body('ToInsert')",
            "where": "@and(equals(item()?['row']?['RecordType'],'transfer'),or(equals(item()?['row']?['StepType'],'resolve'),equals(item()?['row']?['StepType'],'cancel')))"
          },
          "runAfter": {
            "ToInsert": [
              "Succeeded"
            ]
          },
          "type": "Query"
        },
        "Ctx_ids": {
          "inputs": {
            "from": "@variables('ctx')",
            "select": "@item()?['StepId']"
          },
          "runAfter": {
            "Ledger_loop": [
              "Succeeded"
            ]
          },
          "type": "Select"
        },
        "Ctx_pendings": {
          "inputs": {
            "from": "@variables('ctx')",
            "where": "@or(equals(item()?['kind'],'pending'),equals(item()?['kind'],'ledger_pending'))"
          },
          "runAfter": {
            "Map_ctx_rejected": [
              "Succeeded"
            ]
          },
          "type": "Query"
        },
        "Ctx_pre_ids": {
          "inputs": {
            "from": "@variables('ctx')",
            "select": "@item()?['StepId']"
          },
          "runAfter": {
            "Context_loop": [
              "Succeeded"
            ]
          },
          "type": "Select"
        },
        "Ctx_rejects": {
          "inputs": {
            "from": "@variables('ctx')",
            "where": "@or(equals(item()?['kind'],'reject'),equals(item()?['kind'],'ledger_reject'))"
          },
          "runAfter": {
            "Ctx_ids": [
              "Succeeded"
            ]
          },
          "type": "Query"
        },
        "Insert_loop": {
          "actions": {
            "Insert": {
              "inputs": {
                "body": {
                  "ActorId": "@item()?['row']?['ActorId']",
                  "ActorName": "@item()?['row']?['ActorName']",
                  "Deleted": "@item()?['row']?['Deleted']",
                  "DeviceId": "@item()?['row']?['DeviceId']",
                  "FromStoreId": "@item()?['row']?['FromStoreId']",
                  "OwnerStoreId": "@item()?['row']?['OwnerStoreId']",
                  "Payload": "@item()?['row']?['Payload']",
                  "RecordId": "@item()?['row']?['RecordId']",
                  "RecordType": "@item()?['row']?['RecordType']",
                  "Seq": "@item()?['row']?['Seq']",
                  "Status": "@item()?['row']?['Status']",
                  "StepId": "@item()?['row']?['StepId']",
                  "StepType": "@item()?['row']?['StepType']",
                  "SyncTimestamp": "@{div(sub(ticks(utcNow()),621355968000000000),10000)}",
                  "Timestamp": "@item()?['row']?['Timestamp']",
                  "Title": "@item()?['row']?['StepId']",
                  "ToStoreId": "@item()?['row']?['ToStoreId']"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://bangonbrows.sharepoint.com'))}/tables/@{encodeURIComponent(encodeURIComponent('RecordSteps_Staging'))}/items"
              },
              "runAfter": {},
              "type": "ApiConnection"
            },
            "Outcome": {
              "actions": {
                "Append_accepted": {
                  "inputs": {
                    "name": "accepted",
                    "value": "@item()?['row']?['StepId']"
                  },
                  "runAfter": {},
                  "type": "AppendToArrayVariable"
                }
              },
              "else": {
                "actions": {
                  "Dup_or_fail": {
                    "actions": {
                      "Append_duplicate": {
                        "inputs": {
                          "name": "duplicates",
                          "value": "@item()?['row']?['StepId']"
                        },
                        "runAfter": {},
                        "type": "AppendToArrayVariable"
                      }
                    },
                    "else": {
                      "actions": {
                        "Append_failed": {
                          "inputs": {
                            "name": "failed",
                            "value": {
                              "StepId": "@item()?['row']?['StepId']",
                              "reason": "@string(coalesce(outputs('Insert')?['statusCode'],'error'))",
                              "retryable": true
                            }
                          },
                          "runAfter": {},
                          "type": "AppendToArrayVariable"
                        }
                      }
                    },
                    "expression": {
                      "or": [
                        {
                          "equals": [
                            "@coalesce(outputs('Insert')?['statusCode'],0)",
                            409
                          ]
                        },
                        {
                          "contains": [
                            "@toLower(string(coalesce(outputs('Insert')?['body'],'')))",
                            "duplicate values were found"
                          ]
                        }
                      ]
                    },
                    "runAfter": {},
                    "type": "If"
                  }
                }
              },
              "expression": {
                "and": [
                  {
                    "greaterOrEquals": [
                      "@coalesce(outputs('Insert')?['statusCode'],0)",
                      200
                    ]
                  },
                  {
                    "less": [
                      "@coalesce(outputs('Insert')?['statusCode'],0)",
                      300
                    ]
                  }
                ]
              },
              "runAfter": {
                "Insert": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "type": "If"
            }
          },
          "foreach": "@body('ToInsert2')",
          "runAfter": {
            "Map_rejected": [
              "Succeeded"
            ],
            "ToInsert2": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "type": "Foreach"
        },
        "Invariant": {
          "inputs": "@equals(length(coalesce(triggerBody()?['data']?['steps'],json('[]'))),add(add(length(variables('accepted')),length(variables('duplicates'))),add(add(length(body('Rejected')),length(body('Ctx_rejects'))),add(length(variables('failed')),length(body('Ctx_pendings'))))))",
          "runAfter": {
            "Insert_loop": [
              "Succeeded"
            ],
            "Q2_loop": [
              "Succeeded"
            ],
            "Quarantine_loop": [
              "Succeeded"
            ]
          },
          "type": "Compose"
        },
        "LedgerSteps": {
          "inputs": {
            "from": "@body('ToInsert')",
            "where": "@and(equals(item()?['row']?['RecordType'],'transfer'),and(or(equals(item()?['row']?['StepType'],'submit'),or(equals(item()?['row']?['StepType'],'receive'),or(equals(item()?['row']?['StepType'],'resolve'),equals(item()?['row']?['StepType'],'cancel')))),not(contains(body('Ctx_pre_ids'),item()?['row']?['StepId']))))"
          },
          "runAfter": {
            "Ctx_pre_ids": [
              "Succeeded"
            ]
          },
          "type": "Query"
        },
        "Ledger_loop": {
          "actions": {
            "L_badref": {
              "inputs": {
                "from": "@take(coalesce(outputs('L_keys'),json('[]')),200)",
                "where": "@and(contains(body('L_present'),string(item())),not(contains(body('L_okids'),string(item()))))"
              },
              "runAfter": {
                "L_okids": [
                  "Succeeded"
                ],
                "L_present": [
                  "Succeeded"
                ]
              },
              "type": "Query"
            },
            "L_decide": {
              "actions": {
                "Append_ledger_reject": {
                  "inputs": {
                    "name": "ctx",
                    "value": {
                      "StepId": "@items('Ledger_loop')?['row']?['StepId']",
                      "kind": "ledger_reject",
                      "row": "@items('Ledger_loop')?['row']"
                    }
                  },
                  "runAfter": {},
                  "type": "AppendToArrayVariable"
                }
              },
              "else": {
                "actions": {
                  "L_pend_if": {
                    "actions": {
                      "Append_ledger_pending": {
                        "inputs": {
                          "name": "ctx",
                          "value": {
                            "StepId": "@items('Ledger_loop')?['row']?['StepId']",
                            "kind": "ledger_pending",
                            "row": "@items('Ledger_loop')?['row']"
                          }
                        },
                        "runAfter": {},
                        "type": "AppendToArrayVariable"
                      }
                    },
                    "expression": {
                      "and": [
                        {
                          "greater": [
                            "@length(body('L_missing'))",
                            0
                          ]
                        }
                      ]
                    },
                    "runAfter": {},
                    "type": "If"
                  }
                }
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@or(greater(length(body('L_foreign')),0),or(greater(length(body('L_badref')),0),greater(length(coalesce(outputs('L_keys'),json('[]'))),200)))",
                      true
                    ]
                  }
                ]
              },
              "runAfter": {
                "L_badref": [
                  "Succeeded"
                ],
                "L_foreign": [
                  "Succeeded"
                ],
                "L_missing": [
                  "Succeeded"
                ]
              },
              "type": "If"
            },
            "L_filter": {
              "inputs": "@if(equals(length(coalesce(outputs('L_keys'),json('[]'))),0),'TransactionId eq ''__nokey__''',join(body('L_keylist'),' or '))",
              "runAfter": {
                "L_keylist": [
                  "Succeeded"
                ]
              },
              "type": "Compose"
            },
            "L_foreign": {
              "inputs": {
                "from": "@coalesce(body('L_rows')?['value'],json('[]'))",
                "where": "@not(or(equals(item()?['StoreId'],items('Ledger_loop')?['row']?['FromStoreId']),equals(item()?['StoreId'],items('Ledger_loop')?['row']?['ToStoreId'])))"
              },
              "runAfter": {
                "L_rows": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Query"
            },
            "L_found": {
              "inputs": {
                "body": {
                  "headers": {
                    "Accept": "application/json;odata=nometadata"
                  },
                  "method": "GET",
                  "uri": "@{concat('_api/web/lists/getbytitle(''StockTransactions_Validate'')/items?$select=TransactionId,TransferId,StoreId,Type&$top=500&$filter=',body('L_filter'))}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://bangonbrows.sharepoint.com'))}/httpRequest"
              },
              "runAfter": {
                "L_filter": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection"
            },
            "L_keylist": {
              "inputs": {
                "from": "@take(coalesce(outputs('L_keys'),json('[]')),200)",
                "select": "@concat('TransactionId eq ''',replace(string(item()),'''',''),'''')"
              },
              "runAfter": {
                "L_keys": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Select"
            },
            "L_keys": {
              "inputs": "@json(coalesce(items('Ledger_loop')?['row']?['Payload'],'{}'))?['expectedLedgerKeys']",
              "runAfter": {},
              "type": "Compose"
            },
            "L_missing": {
              "inputs": {
                "from": "@take(coalesce(outputs('L_keys'),json('[]')),200)",
                "where": "@not(contains(body('L_present'),string(item())))"
              },
              "runAfter": {
                "L_present": [
                  "Succeeded"
                ]
              },
              "type": "Query"
            },
            "L_okids": {
              "inputs": {
                "from": "@body('L_okrows')",
                "select": "@item()?['TransactionId']"
              },
              "runAfter": {
                "L_okrows": [
                  "Succeeded"
                ]
              },
              "type": "Select"
            },
            "L_okrows": {
              "inputs": {
                "from": "@coalesce(body('L_found')?['value'],json('[]'))",
                "where": "@and(equals(coalesce(item()?['TransferId'],''),coalesce(items('Ledger_loop')?['row']?['RecordId'],'')),or(equals(item()?['StoreId'],items('Ledger_loop')?['row']?['FromStoreId']),equals(item()?['StoreId'],items('Ledger_loop')?['row']?['ToStoreId'])),or(and(equals(items('Ledger_loop')?['row']?['StepType'],'submit'),equals(item()?['Type'],'transfer_out')),or(and(equals(items('Ledger_loop')?['row']?['StepType'],'receive'),equals(item()?['Type'],'transfer_in')),or(and(equals(items('Ledger_loop')?['row']?['StepType'],'cancel'),equals(item()?['Type'],'transfer_in')),and(equals(items('Ledger_loop')?['row']?['StepType'],'resolve'),or(equals(item()?['Type'],'adjustment_in'),or(equals(item()?['Type'],'adjustment_out'),equals(item()?['Type'],'transfer_in'))))))))"
              },
              "runAfter": {
                "L_found": [
                  "Succeeded"
                ]
              },
              "type": "Query"
            },
            "L_present": {
              "inputs": {
                "from": "@coalesce(body('L_found')?['value'],json('[]'))",
                "select": "@item()?['TransactionId']"
              },
              "runAfter": {
                "L_found": [
                  "Succeeded"
                ]
              },
              "type": "Select"
            },
            "L_rows": {
              "inputs": {
                "body": {
                  "headers": {
                    "Accept": "application/json;odata=nometadata"
                  },
                  "method": "GET",
                  "uri": "@{concat('_api/web/lists/getbytitle(''StockTransactions_Validate'')/items?$select=TransactionId,StoreId&$top=500&$filter=TransferId eq ''',replace(items('Ledger_loop')?['row']?['RecordId'],'''',''),'''')}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://bangonbrows.sharepoint.com'))}/httpRequest"
              },
              "runAfter": {},
              "type": "ApiConnection"
            }
          },
          "foreach": "@body('LedgerSteps')",
          "runAfter": {
            "LedgerSteps": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "type": "Foreach"
        },
        "Map_ctx_pending": {
          "inputs": {
            "from": "@body('Ctx_pendings')",
            "select": {
              "StepId": "@item()?['StepId']",
              "reason": "@if(equals(item()?['kind'],'ledger_pending'),'LEDGER_CONTEXT_PENDING','TRANSFER_CONTEXT_PENDING')",
              "retryable": true
            }
          },
          "runAfter": {
            "Ctx_pendings": [
              "Succeeded"
            ]
          },
          "type": "Select"
        },
        "Map_ctx_rejected": {
          "inputs": {
            "from": "@body('Ctx_rejects')",
            "select": {
              "StepId": "@item()?['StepId']",
              "reason": "@if(equals(item()?['kind'],'ledger_reject'),'a referenced ledger row is tagged to this transfer but its store is not the transfer From/To','resolve/cancel store fields do not match the transfer genesis')",
              "reasonCode": "@if(equals(item()?['kind'],'ledger_reject'),'BAD_LEDGER_CONTEXT','BAD_TRANSFER_CONTEXT')"
            }
          },
          "runAfter": {
            "Ctx_rejects": [
              "Succeeded"
            ]
          },
          "type": "Select"
        },
        "Map_rejected": {
          "inputs": {
            "from": "@body('Rejected')",
            "select": {
              "StepId": "@item()?['row']?['StepId']",
              "reason": "@item()?['reason']",
              "reasonCode": "@item()?['reason']"
            }
          },
          "runAfter": {
            "Rejected": [
              "Succeeded"
            ]
          },
          "type": "Select"
        },
        "Match_cred": {
          "inputs": {
            "from": "@coalesce(body('Get_creds')?['value'],json('[]'))",
            "where": "@equals(item()?['StoreId'], replace(coalesce(triggerBody()?['auth']?['storeId'],''),'''',''))"
          },
          "runAfter": {},
          "type": "Query"
        },
        "MoneyBad": {
          "inputs": {
            "from": "@coalesce(body('Call_money')?['bad'],json('[]'))",
            "select": "@item()?['StepId']"
          },
          "runAfter": {
            "Call_money": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          },
          "type": "Select"
        },
        "Q2_loop": {
          "actions": {
            "Q2_insert": {
              "inputs": {
                "body": {
                  "DeviceId": "@items('Q2_loop')?['row']?['DeviceId']",
                  "Title": "@items('Q2_loop')?['StepId']",
                  "TransactionId": "@items('Q2_loop')?['StepId']",
                  "rawRowJson": "@string(items('Q2_loop')?['row'])",
                  "reason": "@if(equals(items('Q2_loop')?['kind'],'ledger_reject'),'BAD_LEDGER_CONTEXT','BAD_TRANSFER_CONTEXT')",
                  "reasonCode": "@if(equals(items('Q2_loop')?['kind'],'ledger_reject'),'BAD_LEDGER_CONTEXT','BAD_TRANSFER_CONTEXT')",
                  "receivedAt": "@{utcNow()}",
                  "workflowRunId": "@{workflow()?['run']?['name']}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://bangonbrows.sharepoint.com'))}/tables/@{encodeURIComponent(encodeURIComponent('StockTransactions_Quarantine'))}/items"
              },
              "runAfter": {},
              "type": "ApiConnection"
            }
          },
          "foreach": "@body('Ctx_rejects')",
          "runAfter": {
            "Ctx_rejects": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "type": "Foreach"
        },
        "Quarantine_loop": {
          "actions": {
            "Q_insert": {
              "inputs": {
                "body": {
                  "DeviceId": "@item()?['row']?['DeviceId']",
                  "Title": "@item()?['row']?['StepId']",
                  "TransactionId": "@item()?['row']?['StepId']",
                  "rawRowJson": "@string(item()?['row'])",
                  "reason": "@item()?['reason']",
                  "reasonCode": "@item()?['reason']",
                  "receivedAt": "@{utcNow()}",
                  "workflowRunId": "@{workflow()?['run']?['name']}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://bangonbrows.sharepoint.com'))}/tables/@{encodeURIComponent(encodeURIComponent('StockTransactions_Quarantine'))}/items"
              },
              "runAfter": {},
              "type": "ApiConnection"
            }
          },
          "foreach": "@body('Rejected')",
          "runAfter": {
            "Rejected": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "type": "Foreach"
        },
        "Rejected": {
          "inputs": {
