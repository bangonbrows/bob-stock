                      "Timestamp": "@item()?['row']?['Timestamp']",
                      "Title": "@item()?['row']?['TransactionId']",
                      "TransactionId": "@item()?['row']?['TransactionId']",
                      "TransferId": "@item()?['row']?['TransferId']",
                      "Type": "@item()?['row']?['Type']",
                      "UnitPriceAtTime": "@item()?['row']?['UnitPriceAtTime']"
                    },
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://bangonbrows.sharepoint.com'))}/tables/@{encodeURIComponent(encodeURIComponent('StockTransactions_Validate'))}/items"
                  },
                  "runAfter": {},
                  "type": "ApiConnection"
                },
                "Outcome": {
                  "actions": {
