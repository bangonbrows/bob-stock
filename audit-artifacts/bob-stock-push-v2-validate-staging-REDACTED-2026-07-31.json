                            },
                            {
                              "contains": [
                                "@toLower(string(coalesce(outputs('Insert')?['body'],'')))",
                                "duplicate values were found"
                              ]
                            }
                          ]
                        },
                        "runAfter": {},
                        "type": "If"
                      }
                    }
                  },
                  "expression": {
