                      "DeleteReason": "@item()?['row']?['DeleteReason']",
                      "DeletedAt": "@item()?['row']?['DeletedAt']",
                      "DeletedBy": "@item()?['row']?['DeletedBy']",
                      "DeviceId": "@item()?['row']?['DeviceId']",
                      "DiscAtSupply": "@item()?['row']?['DiscAtSupply']",
                      "EconSig": "@item()?['EconSig']",
                      "IdempotencyKey": "@coalesce(item()?['row']?['IdempotencyKey'],item()?['row']?['TransactionId'])",
                      "PricingVersion": "@item()?['row']?['PricingVersion']",
                      "ProductId": "@item()?['row']?['ProductId']",
                      "Qty": "@item()?['row']?['Qty']",
                      "Reason": "@item()?['row']?['Reason']",
                      "SellAtSupply": "@item()?['row']?['SellAtSupply']",
