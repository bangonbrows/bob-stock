                  "else": {
                    "actions": {
                      "Dup_or_fail": {
                        "actions": {
                          "Append_duplicate": {
                            "inputs": {
                              "name": "duplicates",
                              "value": "@item()?['row']?['TransactionId']"
                            },
                            "runAfter": {},
                            "type": "AppendToArrayVariable"
                          }
                        },
                        "else": {
                          "actions": {
                            "Append_failed": {
                              "inputs": {
                                "name": "failed",
                                "value": {
                                  "TransactionId": "@item()?['row']?['TransactionId']",
