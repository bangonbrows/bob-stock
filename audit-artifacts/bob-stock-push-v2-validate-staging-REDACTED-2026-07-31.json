{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "actions": {
    "Authorized": {
      "actions": {
        "Attest_failed_map": {
          "inputs": {
            "from": "@body('Attest_rows')",
            "select": {
              "TransactionId": "@item()?['TransactionId']",
              "reason": "ATTEST_UNAVAILABLE",
              "retryable": true
            }
          },
          "runAfter": {
            "Call_attest": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "Select"
        },
        "Attest_rows": {
          "inputs": {
            "from": "@body('ToInsert')",
            "select": "@item()?['row']"
          },
          "runAfter": {
            "ToInsert": [
              "Succeeded"
            ]
          },
          "type": "Select"
        },
        "Call_attest": {
          "inputs": {
            "body": {
              "op": "sign",
              "rows": "@body('Attest_rows')"
            },
            "headers": {
              "Content-Type": "application/json"
            },
            "method": "POST",
            "uri": "https://bob-stock-money-fn.azurewebsites.net/api/attestRows?code=REDACTED"
          },
          "runAfter": {
            "Attest_rows": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          },
          "type": "Http"
        },
        "Catalogue_ok": {
          "inputs": "@and(not(empty(body('Get_products')?['value'])),not(empty(body('Get_stores')?['value'])))",
          "runAfter": {
            "Get_stores": [
              "Succeeded",
              "Failed"
            ]
          },
          "type": "Compose"
        },
        "Get_products": {
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://bangonbrows.sharepoint.com'))}/tables/@{encodeURIComponent(encodeURIComponent('AppConfig'))}/items",
            "queries": {
              "$filter": "ConfigType eq 'products'",
              "$top": 1
            }
          },
          "runAfter": {},
          "type": "ApiConnection"
        },
        "Get_stores": {
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://bangonbrows.sharepoint.com'))}/tables/@{encodeURIComponent(encodeURIComponent('AppConfig'))}/items",
            "queries": {
              "$filter": "ConfigType eq 'stores'",
              "$top": 1
            }
          },
          "runAfter": {
            "Get_products": [
              "Succeeded",
              "Failed"
            ]
          },
          "type": "ApiConnection"
        },
        "Insert_loop": {
          "actions": {
            "Belt": {
              "actions": {
                "Insert": {
                  "inputs": {
                    "body": {
